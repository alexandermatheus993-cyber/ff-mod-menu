<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0D0D0D"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔑 AUTENTICAÇÃO"
        android:textColor="#FFFF4444"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Insira sua key para acessar"
        android:textColor="#FF888888"
        android:textSize="14sp"
        android:layout_marginBottom="32dp"/>

    <EditText
        android:id="@+id/key_input"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/edittext_bg"
        android:hint="Digite sua key..."
        android:textColorHint="#FF666666"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp"
        android:padding="16dp"
        android:singleLine="true"
        android:inputType="textPassword"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/login_btn"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/btn_red"
        android:text="VERIFICAR KEY"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/login_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Key padrão: FFMOD2025PRO"
        android:textColor="#FFFF4444"
        android:textSize="12sp"/>

</LinearLayout>
